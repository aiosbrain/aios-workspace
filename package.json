{
  "name": "@aiosbrain/aios",
  "version": "0.12.0",
  "description": "Agent-native operating system for an individual contributor: governed workspace scaffold, multi-agent harnesses with rubric-gated self-correction, AIOS Team Brain sync client, and a local GUI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiosbrain/aios-workspace.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aios": "scripts/aios.mjs",
    "slack": "scripts/slack.mjs",
    "linear": "scripts/linear.mjs"
  },
  "files": [
    "scripts",
    "scaffold",
    "validation",
    "hooks",
    "dist",
    "packages/foundation/src",
    "packages/foundation/package.json",
    ".claude/rubrics/spec-readiness.md",
    "docs/brain-api.md",
    "docs/agentic-ergonomics/aios-issue-template.md",
    "docs/agentic-ergonomics/aios-finding-template.md",
    "docs/devtools-*.md",
    "docs/ENGINEERING-CONSTITUTION.md",
    "docs/GETTING-STARTED.md",
    "docs/guard-verification.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "packages/foundation"
  ],
  "scripts": {
    "help": "node scripts/npm-menu.mjs",
    "postinstall": "node scripts/ensure-loop-built.mjs && node scripts/postinstall-banner.mjs",
    "aios": "dotenvx run -- node scripts/aios.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "build:loop": "tsc -p tsconfig.json --noEmitOnError",
    "check:context": "node scripts/check-context.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "check:domains": "node scripts/check-domain-isolation.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:codebase-health": "node scripts/check-codebase-health.mjs",
    "check:v1-linear": "node scripts/check-v1-linear-drift.mjs",
    "check:inbox-audit": "node scripts/inbox-redaction-lint.mjs",
    "integration:contracts:validate": "node scripts/integration-contracts.mjs",
    "check:review-evidence-parity": "node scripts/check-review-evidence-parity.mjs",
    "check:linear-skill-parity": "node scripts/check-linear-skill-parity.mjs",
    "guard:selftest": "node scripts/guard-selftest.mjs",
    "eval:transcripts": "node evals/transcript-extraction/extraction-eval.mjs",
    "pr:backlog": "node scripts/pr-backlog-report.mjs",
    "lint": "eslint scripts validation src test packages",
    "lint:fix": "eslint scripts validation src test packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "npm ci",
    "test": "npm run test:prepare && npm run test:node",
    "test:prepare": "node scripts/ensure-native-abi.mjs && npm run build:loop && npm run check:domains && npm run check:size && npm run check:boundaries && npm run check:devtools && npm run check:inbox-audit && npm run check:linear-skill-parity",
    "pretest:node": "node scripts/ensure-native-abi.mjs",
    "test:node": "node scripts/ensure-loop-built.mjs --strict && node scripts/test-suite.mjs",
    "test:node:list": "node scripts/test-suite.mjs --list",
    "test:pack-golden": "AIOS_PACK_GOLDEN_TESTS=1 node --test --test-concurrency=1 test/npm-pack-golden-path.test.mjs",
    "test:package-acceptance": "node test/package-acceptance/run-cell.mjs --pack",
    "test:gateway-contracts": "node --test test/contract-conformance.test.mjs test/gateway-contract.test.mjs",
    "test:gateway-approval-contracts": "node --test test/gateway-contract.test.mjs test/gateway-approval-contract.test.mjs",
    "test:coverage": "npm run test:coverage:report && node scripts/check-coverage.mjs",
    "test:coverage:report": "npm run test:prepare && node scripts/run-coverage.mjs",
    "test:mutation": "node scripts/run-mutation.mjs",
    "test:mutation:nightly": "node scripts/run-mutation.mjs --nightly",
    "check:devtools": "node scripts/devtools-preflight.mjs"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@aios-alpha/design": "^0.6.0",
    "@aiosbrain/aios-devtools": "0.3.1",
    "@aiosbrain/foundation": "^0.1.2",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.122.0",
    "@clack/prompts": "^1.7.0",
    "@dotenvx/dotenvx": "^2.19.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.1"
  }
}
