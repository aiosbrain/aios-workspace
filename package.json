{
  "name": "@aiosbrain/aios",
  "version": "0.10.0",
  "description": "Agent-native operating system for an individual contributor: governed workspace scaffold, multi-agent harnesses with rubric-gated self-correction, AIOS Team Brain sync client, and a local GUI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiosbrain/aios-workspace.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aios": "scripts/aios.mjs"
  },
  "files": [
    "scripts",
    "scaffold",
    "validation",
    "hooks",
    "dist",
    "packages/foundation/src",
    "packages/foundation/package.json",
    "docs/brain-api.md",
    "docs/ENGINEERING-CONSTITUTION.md",
    "docs/GETTING-STARTED.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "gui/server",
    "gui/client",
    "packages/foundation"
  ],
  "scripts": {
    "help": "node scripts/npm-menu.mjs",
    "postinstall": "node scripts/ensure-loop-built.mjs && node scripts/gui-runtime-preflight.mjs --warn-only && node scripts/postinstall-banner.mjs",
    "gui": "node scripts/run-gui.mjs",
    "gui:build": "npm run build --workspace gui/client",
    "gui:preflight": "node scripts/gui-runtime-preflight.mjs",
    "aios": "dotenvx run -- node scripts/aios.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "build:loop": "tsc -p tsconfig.json --noEmitOnError",
    "check:context": "node scripts/check-context.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "check:domains": "node scripts/check-domain-isolation.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:codebase-health": "node scripts/check-codebase-health.mjs",
    "check:v1-linear": "node scripts/check-v1-linear-drift.mjs",
    "check:inbox-audit": "node scripts/inbox-redaction-lint.mjs",
    "eval:transcripts": "node evals/transcript-extraction/extraction-eval.mjs",
    "pr:backlog": "node scripts/pr-backlog-report.mjs",
    "lint": "eslint scripts validation gui/server gui/client/src src test packages",
    "lint:fix": "eslint scripts validation gui/server gui/client/src src test packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "npm ci && npm run gui:build",
    "test": "npm run test:prepare && npm run test:node && npm run test:client && npm run test:rust",
    "test:prepare": "node scripts/ensure-native-abi.mjs && npm run build:loop && npm run check:domains && npm run check:size && npm run check:boundaries && npm run check:inbox-audit",
    "pretest:node": "node scripts/ensure-native-abi.mjs",
    "test:node": "node scripts/ensure-loop-built.mjs --strict && node scripts/test-suite.mjs",
    "test:node:list": "node scripts/test-suite.mjs --list",
    "test:client": "npm run test --workspace gui/client",
    "test:rust": "node scripts/run-rust-tests.mjs",
    "test:install-smoke": "node scripts/test-suite.mjs --only=test/gui-runtime-production-install.test.mjs --live-install --concurrency=1",
    "test:pack-golden": "AIOS_PACK_GOLDEN_TESTS=1 node --test --test-concurrency=1 test/npm-pack-golden-path.test.mjs",
    "test:gateway-contracts": "node --test test/contract-conformance.test.mjs test/gateway-contract.test.mjs",
    "test:gateway-approval-contracts": "node --test test/gateway-contract.test.mjs test/gateway-approval-contract.test.mjs",
    "test:ux": "node test/ux/run-ux.mjs",
    "test:coverage": "npm run test:coverage:report && node scripts/check-coverage.mjs",
    "test:coverage:report": "npm run test:prepare && node scripts/run-coverage.mjs",
    "test:mutation": "node scripts/run-mutation.mjs",
    "test:mutation:smoke": "node scripts/run-mutation.mjs --group=client-auth-permissions --mutate=gui/client/src/lib/token.ts",
    "test:mutation:nightly": "node scripts/run-mutation.mjs --nightly",
    "app:dev": "npm run gui:preflight && npm run gui:build && dotenvx run -- tauri dev",
    "app:build": "npm run gui:preflight && npm run gui:build && tauri build",
    "app:icon": "tauri icon"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@dotenvx/dotenvx": "^2.19.0",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@aios-alpha/design": "^0.3.0",
    "@aiosbrain/aios-devtools": "^0.2.0",
    "@aiosbrain/foundation": "^0.1.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@clack/prompts": "^1.7.0",
    "better-sqlite3": "^13.0.1"
  }
}
