#!/usr/bin/env bash
#
# pre-push-leak-gate — run the confidentiality leak gate before anything is published.
#
# WHY PRE-PUSH AND NOT JUST PRE-COMMIT/CI:
# On a PUBLIC repository, content becomes world-readable the instant a branch is pushed —
# not when a PR merges. The gate was wired into CI (a merge-time check), so a contributor
# could push a branch carrying confidential material, have CI fail, and the content would
# still be public: a failing check cannot unpublish. That is exactly how a client prospect
# brief sat on a public branch of this repo from July until it was found.
#
# Push is the publication event, so push is where the gate belongs.
#
# Local hooks are never version-controlled, so this tracked source is copied into
# .git/hooks/pre-push by scripts/install-leak-gate-push-hook.sh (run automatically by
# `npm install` and `aios worktree add/init`). Worktrees share the primary's hooks dir, so one
# install covers all.
#
# Bypass (deliberately awkward, and it is on you):
#   AIOS_ALLOW_UNGATED_PUSH=1 git push ...

set -euo pipefail

# Git replacement refs (refs/replace/*) rewrite what every object read returns, so a graft can
# show this gate a clean tree while `git push` transmits the ORIGINAL objects — a verdict about
# content that is not the content being published. Clamp every read below to the true objects.
# Exported rather than passed per call so reads added later inherit it by construction, and so
# it reaches the `bash "$gate"` child too. Scrubbed again in run_chained: foreign hooks must see
# the environment Git would have handed them.
aios_inherited_no_replace="${GIT_NO_REPLACE_OBJECTS+set}"
export GIT_NO_REPLACE_OBJECTS=1

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$repo_root" ] || exit 0

updates_file=$(mktemp "${TMPDIR:-/tmp}/aios-pre-push-updates.XXXXXX")
snapshot_root=$(mktemp -d "${TMPDIR:-/tmp}/aios-pre-push-snapshots.XXXXXX")
seen_objects="$snapshot_root/seen-objects"
gate_output="$snapshot_root/gate-output"
trap 'rm -f "$updates_file"; rm -rf "$snapshot_root"' EXIT
cat > "$updates_file"

run_chained() {
  local hooks_dir chained
  local -a chain_env
  # Our replace-blind clamp is a scan-integrity measure, not a workflow preference. Preserved
  # hooks run other people's code, so hand them the environment they would have had without
  # AIOS installed — unless the operator set the variable themselves.
  if [ -n "$aios_inherited_no_replace" ]; then
    chain_env=(env)
  else
    chain_env=(env -u GIT_NO_REPLACE_OBJECTS)
  fi
  # Resolve the chained hook BESIDE this file (the installer writes `pre-push.chained`
  # next to the gate). Re-deriving the hooks dir from core.hooksPath breaks when the gate
  # is installed machine-locally in the common dir of a hooksPath repo (AIO-638): the
  # chain would resolve to a dead `<hooksPath>/pre-push.chained`.
  hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)"
  chained="$hooks_dir/pre-push.chained"
  if [ -x "$chained" ]; then
    "${chain_env[@]}" "$chained" "$@" < "$updates_file"
  fi
  return 0
}

if [ "${AIOS_ALLOW_UNGATED_PUSH:-}" = "1" ]; then
  echo "pre-push: leak gate BYPASSED via AIOS_ALLOW_UNGATED_PUSH=1." >&2
  run_chained "$@"
  exit 0
fi

gate="$repo_root/scripts/leak-gate.sh"
# A missing gate script must not silently allow the push: that is the failure mode this
# whole change exists to remove. Refuse, and say why.
if [ ! -f "$gate" ]; then
  echo "pre-push: scripts/leak-gate.sh not found — refusing to push ungated." >&2
  echo "pre-push: override with AIOS_ALLOW_UNGATED_PUSH=1 if this is genuinely intended." >&2
  exit 1
fi

scan_target() {
  local target="$1" force_product="${2:-0}" status
  if AIOS_LEAK_GATE_PRODUCT_REPO="$force_product" bash "$gate" "$target" \
    > "$gate_output" 2>&1; then
    return 0
  else
    status=$?
  fi
  cat "$gate_output" >&2
  return "$status"
}

scan_treeish() {
  local treeish="$1" snapshot="$snapshot_root/tree" index="$snapshot_root/index"
  grep -qxF "$treeish" "$seen_objects" 2>/dev/null && return 0
  printf '%s\n' "$treeish" >> "$seen_objects"
  rm -rf "$snapshot"
  rm -f "$index"
  mkdir -p "$snapshot"
  if ! GIT_INDEX_FILE="$index" git read-tree "$treeish" ||
    ! GIT_INDEX_FILE="$index" git checkout-index --all --force --prefix="$snapshot/"; then
    echo "pre-push: could not materialize a Git tree for leak scanning." >&2
    return 2
  fi
  # The tree may itself delete the scanner or scaffold signature. It still comes from this
  # product repository, so keep the name-free product rules active while judging it.
  scan_target "$snapshot" 1
}

scan_detached_object() {
  local object="$1" object_type="$2" target="$snapshot_root/detached-object.md"
  grep -qxF "$object" "$seen_objects" 2>/dev/null && return 0
  printf '%s\n' "$object" >> "$seen_objects"
  if ! git cat-file "$object_type" "$object" > "$target"; then
    echo "pre-push: could not read a detached Git object for leak scanning." >&2
    return 2
  fi
  scan_target "$target" 1
}

# A commit's message and identity headers are published objects exactly like its tree, so the
# tree scan alone leaves them ungated. Scan the raw commit object: that covers the message plus
# author/committer names and addresses. Keyed separately from the tree so neither dedupes the
# other. The `.md` materialization name keeps the content rules (including owner-tier
# frontmatter) in force, matching how detached blobs are handled.
scan_commit_metadata() {
  local commit="$1" target="$snapshot_root/commit-message.md"
  grep -qxF "message:$commit" "$seen_objects" 2>/dev/null && return 0
  printf 'message:%s\n' "$commit" >> "$seen_objects"
  if ! git cat-file commit "$commit" > "$target"; then
    echo "pre-push: could not read a commit object for leak scanning." >&2
    return 2
  fi
  scan_target "$target" 1
}

scan_commit_list() {
  local commits="$1" commit status
  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    if scan_commit_metadata "$commit"; then
      :
    else
      status=$?
      return "$status"
    fi
    if scan_treeish "$commit"; then
      continue
    else
      status=$?
      return "$status"
    fi
  done <<< "$commits"
}

# New refs have an all-zero remote SHA. Read the remote itself once so exclusions describe
# what is actually published there now, never a stale refs/remotes/* cache. Unknown remote tips
# are not trusted as exclusions; if the read fails, scanning safely expands to all ancestors.
remote_tips="$snapshot_root/remote-tips"
remote_tips_available=0
if [ -s "$updates_file" ] && [ -n "${2:-}" ]; then
  if git ls-remote --refs "$2" > "$remote_tips" 2>/dev/null; then
    remote_tips_available=1
  fi
fi

gate_status=0
updates_seen=0
zero_sha=0000000000000000000000000000000000000000
while read -r local_ref local_sha _remote_ref remote_sha; do
  local_type=""
  target=""
  target_type=""
  [ -n "${local_ref:-}" ] || continue
  updates_seen=1
  [ "$local_sha" = "$zero_sha" ] && continue

  if ! local_type=$(git cat-file -t "$local_sha" 2>/dev/null); then
    gate_status=2
    break
  fi
  if [ "$local_type" = "tag" ]; then
    if scan_detached_object "$local_sha" tag; then
      :
    else
      gate_status=$?
      break
    fi
    if ! target=$(git rev-parse "$local_sha^{}" 2>/dev/null); then
      gate_status=2
      break
    fi
  else
    target="$local_sha"
  fi
  if ! target_type=$(git cat-file -t "$target" 2>/dev/null); then
    gate_status=2
    break
  fi

  if [ "$target_type" = "commit" ]; then
    if [ "$remote_sha" != "$zero_sha" ]; then
      if ! remote_target=$(git rev-parse "$remote_sha^{}" 2>/dev/null) ||
        ! commits=$(git rev-list "$remote_target..$target"); then
        gate_status=2
        break
      fi
    else
      exclude_args=()
      if [ "$remote_tips_available" -eq 1 ]; then
        while read -r remote_tip _remote_ref_name; do
          if git cat-file -e "$remote_tip^{commit}" 2>/dev/null; then
            exclude_args+=("^$(git rev-parse "$remote_tip^{commit}")")
          fi
        done < "$remote_tips"
      fi
      if ! commits=$(git rev-list "$target" "${exclude_args[@]}"); then
        gate_status=2
        break
      fi
    fi
    if scan_commit_list "$commits"; then
      :
    else
      gate_status=$?
      break
    fi
  elif [ "$target_type" = "tree" ]; then
    if scan_treeish "$target"; then
      :
    else
      gate_status=$?
      break
    fi
  elif [ "$target_type" = "blob" ]; then
    if scan_detached_object "$target" blob; then
      :
    else
      gate_status=$?
      break
    fi
  else
    echo "pre-push: unsupported Git object type; refusing to publish unscanned." >&2
    gate_status=2
    break
  fi
done < "$updates_file"

# A direct/manual hook invocation has no ref-update stream. Keep it useful by scanning the
# current checkout, but a real push is judged from every commit Git says will be published.
if [ "$updates_seen" -eq 0 ]; then
  if scan_target "$repo_root"; then
    :
  else
    gate_status=$?
  fi
fi

if [ "$gate_status" -eq 0 ]; then
  # Hand off the exact ref-update stream to every pre-existing pre-push hook the installer
  # preserved. Any chained failure remains our failure.
  run_chained "$@"
  exit 0
fi

echo >&2
if [ "$gate_status" -ne 1 ]; then
  echo "pre-push: BLOCKED — the leak-gate scan could not complete safely." >&2
  echo "pre-push: no confidentiality verdict was produced; fix the scanner error before pushing." >&2
  echo "pre-push: override with AIOS_ALLOW_UNGATED_PUSH=1 only if publication is intentional." >&2
  exit 1
fi

echo "pre-push: BLOCKED — the leak gate found confidential material in the tree." >&2
echo "pre-push: this repository is PUBLIC; pushing publishes immediately, and a later" >&2
echo "pre-push: CI failure or branch deletion cannot fully undo that." >&2
echo "pre-push: team/client context belongs in your workspace or the team brain, not here." >&2
exit 1
