#!/usr/bin/env bash
#
# pre-commit-primary-guard — block ALL authored commits in the PRIMARY checkout.
#
# AIOS requires every agent to do its work in a dedicated `git worktree`
# (`aios worktree add <feat/branch>`), NEVER as a commit made in the primary
# checkout. Automated harnesses (e.g. oh-my-opencode / Codex, and a Linear agent
# observed writing code on `main`) have been seen committing directly in the
# primary checkout — stranding it on a feature branch, landing feature work
# straight on `main`, and producing duplicate PRs.
#
# This hook makes that structurally loud: a commit is BLOCKED whenever the
# working copy is the PRIMARY checkout (not a linked worktree) — on EVERY
# branch, including `main`. The primary should only ever advance via
# `git merge --ff-only` from origin, which moves the ref WITHOUT creating a
# commit and so never invokes this hook. Any authored commit here is the
# anti-pattern we're closing.
#
# Merge commits: a `git merge` that is NOT a fast-forward DOES invoke pre-commit
# and is therefore blocked too. That is intentional — the primary is meant to be
# ff-only, so a non-ff merge in the primary is itself the anti-pattern. Use the
# override below if you genuinely must create one.
#
# It is a NO-OP inside a legitimate linked worktree (where all real work belongs).
#
# Override for a genuinely intentional primary-checkout commit (rare hotfix or a
# deliberate non-ff merge on `main`):
#   AIOS_ALLOW_PRIMARY_COMMIT=1 git commit ...
#
# Installed to `.git/hooks/pre-commit` by `scripts/install-primary-commit-guard.sh`.
# git hooks are NOT version-controlled; this tracked source is the durable copy.
# The installer chains any pre-existing pre-commit hook (e.g. the NDA leak gate)
# to `.git/hooks/pre-commit.chained`, which this guard execs on success.

set -euo pipefail

DEFAULT_BRANCH="main"

# Resolve the chained hook BESIDE this file, not via `git rev-parse --git-path
# hooks/...`: that helper honors core.hooksPath, so when this guard is installed
# machine-locally in the common dir of a hooksPath repo (AIO-638) it would point
# at a dead `<hooksPath>/pre-commit.chained` instead of our sibling.
chained="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)/pre-commit.chained"

# ── Physical paths ─────────────────────────────────────────────────────────
# Resolve symlinks (`pwd -P`) on both sides: `--absolute-git-dir` is physical,
# while a relative `--git-common-dir` resolved with a logical `pwd` keeps the
# symlink — so a commit run from a symlinked cwd (e.g. ~/Tessera -> ~/Projects)
# compared unequal, was taken for a linked worktree, and slipped through.
physical_dir() {
  [[ -n "$1" ]] || return 0
  (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1"
}
git_dir="$(physical_dir "$(git rev-parse --absolute-git-dir 2>/dev/null || true)")"
common_dir="$(physical_dir "$(git rev-parse --git-common-dir 2>/dev/null || true)")"

# ── Scope: only repos the machine owner has opted in ───────────────────────
# This is a machine-local developer policy, not something a repo imposes. It
# enforces ONLY in repos listed under `protect` in the same scope file the
# Claude Code branch-protection hook reads:
#
#   ~/.claude/branch-protection.json   (override: AIOS_BRANCH_PROTECTION_CONFIG)
#   {"protect": [<repo roots>], "exempt": [<repo roots>]}
#
# A pure allowlist: `exempt` always wins, and there is no protect-everything mode
# (`mode` is ignored), so no config can pull an unlisted repo into scope. A
# missing or unreadable file, unset HOME, or no `node` means OUT of scope — so a
# guard that lands in a personal workspace (or any unlisted repo) blocks nothing.
#
# Scope is judged against the PRIMARY checkout's root (its toplevel, or from a
# linked worktree the parent of the common git dir), so a linked worktree of a
# protected repo is in scope too — the installer relies on that — while the
# primary-vs-worktree check below still
# lets worktree commits through.
#
# `AIOS_PRIMARY_GUARD_SCOPE_CHECK=1` makes this script answer only the scope
# question (exit 0 = in scope) — the installer uses it, so the two never drift.
repo_in_scope() {
  local root cfg default_cfg=""
  [[ -n "$common_dir" ]] || return 1
  if [[ "$git_dir" == "$common_dir" ]]; then
    # The primary checkout: ask git for its root. `dirname` of the git dir is wrong
    # for --separate-git-dir, a symlinked .git, and submodules (.git/modules/<name>).
    root="$(physical_dir "$(git rev-parse --show-toplevel 2>/dev/null || true)")"
  else
    root="$(dirname "$common_dir")"
  fi
  [[ -n "$root" ]] || return 1
  [[ -n "${HOME:-}" ]] && default_cfg="$HOME/.claude/branch-protection.json"
  cfg="${AIOS_BRANCH_PROTECTION_CONFIG:-$default_cfg}"
  [[ -n "$cfg" && -f "$cfg" ]] || return 1
  command -v node >/dev/null 2>&1 || return 1
  node -e '
    const fs = require("fs"), path = require("path"), os = require("os");
    const [cfgPath, rootRaw] = process.argv.slice(1);
    const norm = (p) => {
      if (typeof p !== "string" || !p.trim()) return null;
      p = p.trim();
      if (p === "~" || p.startsWith("~/")) p = path.join(os.homedir(), p.slice(1));
      p = path.resolve(p);
      try { return fs.realpathSync(p); } catch { return p; }
    };
    const under = (r, l) => r === l || r.startsWith(l.endsWith(path.sep) ? l : l + path.sep);
    const cfg = JSON.parse(fs.readFileSync(cfgPath, "utf8"));
    const root = norm(rootRaw);
    const list = (k) => (Array.isArray(cfg[k]) ? cfg[k] : []).map(norm).filter(Boolean);
    if (!root || list("exempt").some((l) => under(root, l))) process.exit(1);
    process.exit(list("protect").some((l) => under(root, l)) ? 0 : 1);
  ' "$cfg" "$root" 2>/dev/null
}

if [[ "${AIOS_PRIMARY_GUARD_SCOPE_CHECK:-}" == "1" ]]; then
  repo_in_scope
  exit $?
fi

if ! repo_in_scope; then
  if [[ -x "$chained" ]]; then
    exec "$chained" "$@"
  fi
  exit 0
fi

# ── Detect PRIMARY vs linked WORKTREE ──────────────────────────────────────
# In the primary checkout, the git dir IS the common git dir.
# In a linked worktree, the git dir is `<common>/worktrees/<name>` — different.
is_primary=0
if [[ -n "$git_dir" && "$git_dir" == "$common_dir" ]]; then
  is_primary=1
fi

if [[ "$is_primary" == "1" ]]; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
  if [[ "${AIOS_ALLOW_PRIMARY_COMMIT:-}" == "1" ]]; then
    echo "[aios] AIOS_ALLOW_PRIMARY_COMMIT=1 set — allowing commit on '$branch' in the primary checkout." >&2
  else
    suggest_branch="$branch"
    if [[ "$suggest_branch" == "$DEFAULT_BRANCH" || "$suggest_branch" == "HEAD" ]]; then
      suggest_branch="feat/<short-task-name>"
    fi
    cat >&2 <<EOF

┌─────────────────────────────────────────────────────────────────────────────┐
│  AIOS worktree guard: commit BLOCKED in the PRIMARY checkout                 │
└─────────────────────────────────────────────────────────────────────────────┘

You are committing to branch '$branch' inside the PRIMARY checkout:
  $(git rev-parse --show-toplevel 2>/dev/null)

AIOS requires ALL work to live in a dedicated git worktree — the primary
checkout must never carry an authored commit on ANY branch, including '$DEFAULT_BRANCH'.
It should only ever advance via 'git merge --ff-only' from origin (which moves
the ref without a commit and never triggers this hook). Do this instead:

  aios worktree add $suggest_branch
  cd ../$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")-worktrees/${suggest_branch//\//-}
  # then commit there

If this really is an intentional primary-checkout commit (a rare hotfix, or a
deliberate non-ff merge on '$DEFAULT_BRANCH'), re-run:

  AIOS_ALLOW_PRIMARY_COMMIT=1 git commit ...

EOF
    exit 1
  fi
fi

# ── Chain to any pre-existing pre-commit hook (e.g. the NDA leak gate) ──────
if [[ -n "$chained" && -x "$chained" ]]; then
  exec "$chained" "$@"
fi

exit 0
