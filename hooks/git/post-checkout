#!/usr/bin/env bash
# post-checkout hook: auto-hydrate a freshly created git worktree with config
# from the primary checkout. Fires on every checkout, but only hydrates when
# the previous HEAD is all-zeros (fresh worktree) and opencode.json is missing.
#
# Installed by: aios worktree --install-hook
# Removed by:    aios worktree --uninstall-hook
#
# Passes silently when not applicable — never blocks a checkout.

set -euo pipefail

prev_head="$1"
new_head="$2"
checkout_flag="$3"

# Only act on branch checkouts (flag=1) with a zero previous HEAD (new worktree)
if [[ "$checkout_flag" != "1" ]]; then exit 0; fi
if [[ "$prev_head" != "0000000000000000000000000000000000000000" ]]; then exit 0; fi

# Determine if we're in a worktree (not the primary)
common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [[ -z "$common_dir" ]]; then exit 0; fi

main_worktree="$(cd "$(dirname "$common_dir")" 2>/dev/null && pwd || true)"
here="$(pwd)"

# Not a worktree? Skip.
if [[ "$main_worktree" == "$here" ]]; then exit 0; fi

# Already hydrated? Skip. The marker (written last by link-worktree-env.sh) is the
# authoritative signal. It replaces an earlier `opencode.json`-presence check, which
# was ambiguous: a repo that *tracks* opencode.json checks it out into every fresh
# worktree, so that check read "hydrated" for a worktree that had never been touched
# and silently disabled auto-hydration for exactly the tools this exists for.
if [[ -f "$here/.aios/.worktree-hydrated" ]]; then exit 0; fi

# Resolve the checkout that owns the hydrator. A *scaffolded workspace* vendors only
# the `aios` shim (scripts/aios.mjs), not scripts/link-worktree-env.sh — that lives in
# the canonical toolkit checkout. Without this fallback the hook is a silent no-op in
# exactly the repos this feature exists for. Candidate order mirrors
# hooks/worktree-self-heal.mjs and scaffold/scripts/aios.mjs.
script=""
for dir in \
  "$main_worktree" \
  "${AIOS_TOOLKIT_DIR:-}" \
  "$main_worktree/../aios-workspace" \
  "$main_worktree/../aios/aios-workspace" \
  "$main_worktree/../../aios-workspace"; do
  [[ -z "$dir" ]] && continue
  if [[ -f "$dir/scripts/link-worktree-env.sh" ]]; then
    script="$dir/scripts/link-worktree-env.sh"
    break
  fi
done

if [[ -z "$script" ]]; then
  echo "[aios] link-worktree-env.sh not found — skipping auto-hydration"
  exit 0
fi

echo "[aios] new worktree detected — auto-hydrating config from $main_worktree ..."
bash "$script"
