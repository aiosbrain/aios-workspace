{
  "name": "@aiosbrain/foundation",
  "version": "0.1.2",
  "description": "Shared hub modules of the AIOS workspace toolkit (AIO-601, multi-repo split): agent-runtime registry, workspace content parsers, brain/linear clients, git-backed file enumeration, and the engineering-constitution digest loader. ESM subpath exports only — no root export.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiosbrain/aios-workspace.git",
    "directory": "packages/foundation"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "peerDependencies": {
    "@dotenvx/dotenvx": "^2.19.1"
  },
  "peerDependenciesMeta": {
    "@dotenvx/dotenvx": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./runtimes": "./src/runtimes.mjs",
    "./workspace-markers": "./src/workspace-markers.mjs",
    "./adapter-contract": "./src/adapter-contract.mjs",
    "./workspace-parse": {
      "types": "./src/workspace-parse/index.d.mts",
      "default": "./src/workspace-parse/index.mjs"
    },
    "./brain-config": "./src/brain-config.mjs",
    "./linear-client": "./src/linear-client.mjs",
    "./brain-client": "./src/brain-client.mjs",
    "./git-files": "./src/git-files.mjs",
    "./constitution": "./src/constitution.mjs",
    "./tasks-table": {
      "types": "./src/tasks-table.d.mts",
      "default": "./src/tasks-table.mjs"
    },
    "./internal/flat-yaml": {
      "types": "./src/internal/flat-yaml.d.mts",
      "default": "./src/internal/flat-yaml.mjs"
    },
    "./internal/brain-origin": "./src/internal/brain-origin.mjs",
    "./internal/transcript-adapters": "./src/internal/transcript-adapters.mjs",
    "./internal/skill-scan": "./src/internal/skill-scan.mjs"
  }
}
