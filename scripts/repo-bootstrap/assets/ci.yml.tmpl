# CI skeleton seeded by `aios repo-bootstrap` (AIO-602). This repo owns it from here —
# the bootstrap never overwrites an existing ci.yml. The governance-gates job mirrors
# the aios-workspace invariants (ENGINEERING-CONSTITUTION.md §8): file-size cap,
# repo-boundary seams, and the static workflow policy.
#
# ── NO SECRET-BEARING PR SCANNER IS GENERATED HERE, ON PURPOSE ────────────────────────
# Earlier versions of this template seeded a `pull_request`-triggered confidentiality gate
# that read a term corpus out of an Actions secret. That shape is now prohibited
# (leak-gate-remediation-plan.md §1 invariant 1 and §5.1 item 4): a job reachable from a pull
# request must not hold a durable credential, because PR-controlled code, dependencies, and
# workflow YAML can all exfiltrate it. A newly bootstrapped repo therefore starts with **no**
# secret in **any** job, and `workflow-policy` below keeps it that way.
#
# Confidentiality scanning still exists, in two places that are not this file:
#   • locally, as the advisory pre-push helper the bootstrap installs
#     (`scripts/leak-gate.sh` + `hooks/git/pre-push-leak-gate`, no corpus in the repo); and
#   • authoritatively, as the `AIOS Security Gate` commit status published by the
#     `aios-security-gate` GitHub App, which scans Git objects directly and never runs in Actions.
#
# TODO(leak-gate-remediation-plan.md §4.1 / §5.2, phases 3 → 6 → 7): enroll this repository with
# the `aios-security-gate` GitHub App and the organization ruleset that requires the
# `AIOS Security Gate` commit status from that exact App source, with strict current-base checks
# and no bypass actors. That half is NOT buildable yet — the App does not exist and is blocked on
# the dedicated AWS Security account (plan phase 1). Do not invent enrollment configuration here:
# when the App ships, enrollment is a ruleset change plus an installation, not a workflow. Nothing
# in this file may create, write, or satisfy the `AIOS Security Gate` context.
name: ci

on:
  pull_request:
  push:
    branches: [main]

# Default-deny at the workflow level. A job that genuinely needs more asks for it itself, which
# makes the elevation visible in review — and `checks: write` / `statuses: write` stay banned in
# anything a pull request can reach.
permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  gates:
    name: governance gates (size + boundaries)
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
      - name: File-size gate (default-deny, ratchet-only-down)
        run: node scripts/check-file-size.mjs
      - name: Repo-boundary gate
        run: node scripts/check-boundaries.mjs

  workflow-policy:
    name: workflow policy (PR-reachable workflows)
    runs-on: ubuntu-latest
    # Deliberately the least privileged job in this file: read-only, no secret, and no
    # `checks`/`statuses` scope. It reads workflow YAML as data and never executes a workflow.
    # It does NOT create the required `AIOS Security Gate` status — only the App may.
    #
    # THE JUDGING CODE COMES FROM THE BASE REVISION, NEVER FROM THE PULL REQUEST. A bare checkout
    # here would be the candidate revision on `pull_request`, so a PR could add a secret-bearing
    # workflow AND, in the same commit, edit the checker to return success or grant itself an
    # allowlist waiver — and this required lane would go green. The allowlist is resolved from the
    # base for the identical reason: a PR that can add its own waiver is the same bypass. Same
    # shape as aios-workspace's own .github/workflows/ci.yml; keep the two in step.
    permissions:
      contents: read
    steps:
      - name: Check out the gate from the base revision
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.base.sha || github.event.repository.default_branch }}
          persist-credentials: false

      - name: Locate the gate
        id: gate
        run: |
          if test -f scripts/check-workflow-policy.mjs; then
            echo "root=$PWD" >> "$GITHUB_OUTPUT"
            echo "bootstrap=false" >> "$GITHUB_OUTPUT"
          else
            echo "root=$PWD/pr-head" >> "$GITHUB_OUTPUT"
            echo "bootstrap=true" >> "$GITHUB_OUTPUT"
            echo "::warning title=Workflow-policy gate bootstrap::The base revision does not carry the gate yet, so this run judges with the pull request's own copy. This path is correct ONLY for the PR that introduces the gate; every later PR is judged by the base-revision checker, because by then the base carries it."
          fi

      - name: Bootstrap — judge with the PR's own copy (base has no gate yet)
        if: steps.gate.outputs.bootstrap == 'true' && github.event_name == 'pull_request'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: refs/pull/${{ github.event.pull_request.number }}/head
          path: pr-head
          persist-credentials: false

      # The candidate tree is scanner INPUT only. The checker parses YAML as data and never
      # executes a workflow, a step, an action, or a `run:` body.
      - name: Check out the candidate tree as inert scanner input
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          path: candidate
          persist-credentials: false

      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22

      # Fails if any workflow reachable from a PR-like event references `secrets.*`, requests
      # `checks: write` / `statuses: write`, names the `AIOS Security Gate` context, uses an
      # action not pinned to a full 40-hex commit SHA, or combines `pull_request_target` with
      # PR checkout, artifact download, package install, or `${{ }}` interpolation of
      # attacker-controlled expressions into a `run:` body. Reviewed exceptions go in
      # scripts/workflow-policy-allowlist.json, one (workflow, job, rule) triple at a time.
      - name: Workflow policy (base-revision gate over the candidate workflows)
        working-directory: candidate
        env:
          GATE_ROOT: ${{ steps.gate.outputs.root }}
        run: |
          node "$GATE_ROOT/scripts/check-workflow-policy.mjs" \
            --allowlist "$GATE_ROOT/scripts/workflow-policy-allowlist.json"

  lint:
    name: lint
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then npm ci; elif [ -f package.json ]; then npm install; fi
      - name: Lint
        run: |
          if [ -f package.json ]; then npm run {{LINT_SCRIPT}} --if-present; else echo "no package.json — skipping lint"; fi

  test:
    name: unit tests
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then npm ci; elif [ -f package.json ]; then npm install; fi
      - name: Test
        run: |
          if [ -f package.json ]; then npm run {{TEST_SCRIPT}} --if-present; else echo "no package.json — skipping tests"; fi
